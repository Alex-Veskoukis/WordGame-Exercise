# ============================================
# Environment Variables for Word Game
# ============================================
# Copy this file to .env and customize values

# ============================================
# DATABASE SETTINGS
# ============================================
POSTGRES_USER=gameuser
POSTGRES_PASSWORD=gamepass123
POSTGRES_DB=wordgame

# ============================================
# APPSMITH SETTINGS
# ============================================
# IMPORTANT: Change these for production!
APPSMITH_ENCRYPTION_PASSWORD=change_this_secure_password_123
APPSMITH_ENCRYPTION_SALT=change_this_secure_salt_456

# ============================================
# EXTERNAL API KEYS
# ============================================
# Groq API for AI-powered hints (optional)
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=

# ============================================
# NOTES
# ============================================
# - Keep this file secure and never commit it to git
# - Add .env to your .gitignore file
# - For production, use strong passwords and secrets
# - The GROQ_API_KEY is optional but enables AI hints
